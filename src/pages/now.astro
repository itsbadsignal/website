---
import BaseLayout from '../layouts/BaseLayout.astro';
import { now } from '../lib/site';
---

<BaseLayout title="now" description="What I'm doing at the moment.">
  <header class="page-head">
    <h1>now</h1>
    <p>What I'm doing at the moment. Edit in src/lib/site.ts.</p>
  </header>

  <dl class="now">
    {
      now.map((n) => (
        <div>
          <dt class="dim">{n.label}</dt>
          <dd>{n.value}</dd>
        </div>
      ))
    }
  </dl>
</BaseLayout>

<style>
  .now div {
    display: grid;
    grid-template-columns: 12ch 1fr;
  }
</style>
