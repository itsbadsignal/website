---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="Nothing here." prank={false}>
  <header class="page-head">
    <h1>404</h1>
    <p>segmentation fault: that page isn't mapped.</p>
  </header>

  <pre class="dump">{`$ ./site --route ????
[*] resolving ...
[!] no such symbol
[*] core dumped`}</pre>
  <a class="back" href="/">← back to index</a>
</BaseLayout>

<style>
  .dump {
    font: inherit;
    padding: 1rem;
    border: var(--rule);
    white-space: pre-wrap;
  }
</style>
