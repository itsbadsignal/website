---
import BaseLayout from './BaseLayout.astro';
import Cover from '../components/Cover.astro';
import TagChip from '../components/TagChip.astro';
import { formatDate, type Post } from '../lib/posts';
import '../styles/prose.css';

interface Props {
  post: Post;
  readingTime: string;
}

const { post, readingTime } = Astro.props;
const { title, description, pubDate, updatedDate, tags, math, draft, cover } = post.data;
---

<BaseLayout title={title} description={description} math={math} image={cover?.src}>
  <article>
    <header class="post-head">
      <h1>{title}</h1>
      <p class="dim">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {` · ${readingTime}`}
        {
          updatedDate && (
            <>
              {' · updated '}
              <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
            </>
          )
        }
        {draft && ' · [draft]'}
      </p>
      {
        tags.length > 0 && (
          <p class="post-tags">
            {tags.map((t) => (
              <TagChip tag={t} />
            ))}
          </p>
        )
      }
    </header>

    <div class="post-cover">
      <Cover post={post} width={720} eager />
    </div>

    <div class="prose">
      <slot />
    </div>
  </article>

  <a class="back" href="/blog">← all posts</a>
</BaseLayout>

<style>
  .post-head h1 {
    font-size: 1.15rem;
    line-height: 1.4;
    text-wrap: balance;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
  }

  .post-cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    margin-block: 1.5rem 2rem;
  }
</style>
