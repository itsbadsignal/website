---
/**
 * The chaos layer: fixed, full-viewport, decorative.
 *
 * The reference site hardcodes ~40 absolutely-positioned CSS rules. This drives
 * the same look from a typed array, so moving or adding an element is a one-line
 * data edit and items can be culled by priority on narrow screens.
 *
 * Opacity is driven by --chaos-opacity, written on :root by BaseLayout's
 * rAF-throttled scroll handler.
 */
import { Image } from 'astro:assets';
import { socials, site } from '../lib/site';
import '../styles/chaos.css';

import portrait from '../assets/scatter/portrait.png';
import ascii from '../assets/scatter/ascii.png';

type Priority = 1 | 2 | 3;

type TextItem = {
  kind: 'text';
  content: string;
  /** viewport percentages */
  x: number;
  y: number;
  size?: string;
  weight?: 400 | 500 | 700;
  font?: 'sans' | 'mono';
  opacity?: number;
  rotate?: number;
  priority?: Priority;
};

type ImageItem = {
  kind: 'image';
  src: ImageMetadata;
  alt?: string;
  x: number;
  y: number;
  width: number;
  opacity?: number;
  rotate?: number;
  priority?: Priority;
  /**
   * Tone of the art's subject on its transparent ground. The page is always dark,
   * so 'dark' art is inverted in CSS to keep it from vanishing into the ground.
   * Getting this wrong makes the image invisible.
   */
  subject: 'dark' | 'light';
};

type Item = TextItem | ImageItem;

/*
 * Scattered imagery — deliberately sparse. The page reads as monochrome type on
 * a grid, so a single image is the one thing the eye lands on; a second one
 * turns it back into collage. See src/assets/scatter/README.md.
 */
const IMAGES: ImageItem[] = [
  { kind: 'image', src: portrait, x: 68, y: 9, width: 260, opacity: 0.38, subject: 'dark', priority: 1 },
  // the portrait again, rendered as ASCII by scripts/ascii-portrait.py. The glyphs
  // cover only ~5% of the image, so this runs higher than the portrait to land at
  // a comparable weight
  { kind: 'image', src: ascii, x: 73, y: 46, width: 360, opacity: 0.7, subject: 'light', priority: 2 },
];

/* Scattered phrases. Lowercase, monochrome — edit freely. */
const TEXT: TextItem[] = [
  /*
   * Sits below the panel row rather than beside it. The panels are a fixed-height
   * block in rem while these y values are viewport percentages, so anything in the
   * top third collides on a short window even when it clears on a tall one.
   */
  { kind: 'text', content: 'wth am i doing?', x: 14, y: 42, size: '1rem', opacity: 0.6, priority: 3 },
  // priority 2: at 1.75rem starting at 66% it runs off the right edge on a phone
  { kind: 'text', content: "lot's of moving parts", x: 66, y: 70, size: '1.75rem', weight: 500, opacity: 0.5, priority: 2 },
  { kind: 'text', content: 'it broke for a reason', x: 10, y: 78, size: '0.9375rem', opacity: 0.45, priority: 1 },
  // clear of the panel row, which runs to roughly 22% of the viewport height
  { kind: 'text', content: 'off by one', x: 46, y: 32, size: '1rem', opacity: 0.4, rotate: -1, priority: 2 },
];

const ITEMS: Item[] = [...IMAGES, ...TEXT];

/*
 * Decorative primitives. Positions avoid two occupied zones: the panel row
 * across the top left, and the portrait at 68–86% on the top right.
 */
const BARS = [
  { x: 90, y: 22, w: 3, h: 42 },
  { x: 21, y: 86, w: 2, h: 30 },
  { x: 55, y: 3, w: 42, h: 3 },
];

const RULES = [
  { x: 4, y: 70, w: 18, rotate: -8 },
  { x: 54, y: 92, w: 14, rotate: 5 },
];

const BOXES = [
  { x: 4, y: 46, w: 70, h: 70, rotate: 12 },
  { x: 88, y: 40, w: 44, h: 44, rotate: -6 },
];

/* Build stamp, generated at build time rather than hand-edited. */
const d = new Date();
const build = `build ${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<div class="chaos" aria-hidden="true">
  <div class="chaos__grid"></div>

  {
    ITEMS.map((item) =>
      item.kind === 'image' ? (
        <div
          class="chaos__item chaos__img"
          data-priority={item.priority ?? 1}
          data-subject={item.subject}
          style={`left:${item.x}%;top:${item.y}%;width:min(${item.width}px, 42vw);opacity:${item.opacity ?? 0.5};transform:rotate(${item.rotate ?? 0}deg)`}
        >
          <Image src={item.src} alt="" loading="lazy" decoding="async" widths={[item.width, item.width * 2]} />
        </div>
      ) : (
        <span
          class="chaos__item chaos__text"
          data-priority={item.priority ?? 1}
          data-font={item.font ?? 'sans'}
          style={`left:${item.x}%;top:${item.y}%;font-size:${item.size ?? '1rem'};font-weight:${item.weight ?? 400};opacity:${item.opacity ?? 0.5};transform:rotate(${item.rotate ?? 0}deg)`}
        >
          {item.content}
        </span>
      )
    )
  }

  {BARS.map((b) => (
    <span class="chaos__bar" style={`left:${b.x}%;top:${b.y}%;width:${b.w}px;height:${b.h}px`}></span>
  ))}

  {RULES.map((r) => (
    <span class="chaos__rule" style={`left:${r.x}%;top:${r.y}%;width:${r.w}%;transform:rotate(${r.rotate}deg)`}></span>
  ))}

  {BOXES.map((b) => (
    <span class="chaos__box" style={`left:${b.x}%;top:${b.y}%;width:${b.w}px;height:${b.h}px;transform:rotate(${b.rotate}deg)`}></span>
  ))}

  <span class="chaos__bracket" data-corner="tl">┌</span>
  <span class="chaos__bracket" data-corner="tr">┐</span>
  <span class="chaos__bracket" data-corner="bl">└</span>
  <span class="chaos__bracket" data-corner="br">┘</span>

  <span class="chaos__status"><i class="chaos__dot"></i>{site.status}</span>
  <span class="chaos__build">{build}</span>
  <span class="chaos__scan"></span>
</div>

{/* Kept outside .chaos: focusable links must never live in an aria-hidden subtree,
    or keyboard users can tab to something screen readers refuse to announce. */}
<nav class="chaos__social" aria-label="Elsewhere">
  {socials.map((s) => (
    <a
      href={s.href}
      rel={s.href.startsWith('http') ? 'noopener me' : undefined}
      target={s.href.startsWith('http') ? '_blank' : undefined}>{s.label}</a>
  ))}
</nav>
