---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostLog from '../../components/PostLog.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<BaseLayout title="Blog" description="Writeups and research notes.">
  <header class="page-head">
    <h1>Blog</h1>
    <p>{posts.length} {posts.length === 1 ? 'entry' : 'entries'}, newest first, grouped by year.</p>
  </header>

  {posts.length > 0 ? <PostLog posts={posts} /> : <p class="dim">nothing published yet.</p>}
</BaseLayout>
