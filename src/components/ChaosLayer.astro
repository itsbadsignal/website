---
/**
 * The chaos layer: fixed, full-viewport, decorative.
 *
 * The reference site hardcodes ~40 absolutely-positioned CSS rules. This drives
 * the same look from a typed array, so moving or adding an element is a one-line
 * data edit and items can be culled by priority on narrow screens.
 *
 * Opacity is driven by --chaos-opacity, written on :root by BaseLayout's
 * rAF-throttled scroll handler.
 */
import { Image } from 'astro:assets';
import { socials, site } from '../lib/site';
import '../styles/chaos.css';

import terminal from '../assets/scatter/terminal.png';
import disasm from '../assets/scatter/disasm.png';
import hexdump from '../assets/scatter/hexdump.png';
import ascii from '../assets/scatter/ascii.png';
import signal from '../assets/scatter/signal.png';

type Priority = 1 | 2 | 3;

type TextItem = {
  kind: 'text';
  content: string;
  /** viewport percentages */
  x: number;
  y: number;
  size?: string;
  weight?: 400 | 500 | 700;
  font?: 'sans' | 'mono';
  opacity?: number;
  rotate?: number;
  priority?: Priority;
};

type ImageItem = {
  kind: 'image';
  src: ImageMetadata;
  alt?: string;
  x: number;
  y: number;
  width: number;
  opacity?: number;
  rotate?: number;
  priority?: Priority;
};

type Item = TextItem | ImageItem;

/*
 * Scattered imagery. These carry all of the page's colour — see
 * src/assets/scatter/README.md before removing any of them.
 */
/*
 * Opacity note: the reference site sits on white, so 0.4–0.8 knocked its imagery
 * back nicely. On a near-black ground a dark screenshot at that opacity simply
 * disappears — its background *is* the page background, so opacity only erases
 * the coloured foreground. Dark-bodied captures therefore run high here.
 */
const IMAGES: ImageItem[] = [
  { kind: 'image', src: terminal, x: 4, y: 34, width: 340, opacity: 0.82, rotate: -2, priority: 1 },
  { kind: 'image', src: ascii, x: 73, y: 46, width: 360, opacity: 0.5, rotate: 0, priority: 1 },
  { kind: 'image', src: signal, x: 60, y: 6, width: 300, opacity: 0.7, rotate: 3, priority: 2 },
  { kind: 'image', src: disasm, x: 30, y: 71, width: 330, opacity: 0.78, rotate: -1, priority: 2 },
  { kind: 'image', src: hexdump, x: 8, y: 5, width: 260, opacity: 0.62, rotate: 2, priority: 3 },
];

/* Scattered phrases. Lowercase, monochrome — edit freely. */
const TEXT: TextItem[] = [
  { kind: 'text', content: 'segfault is just feedback', x: 14, y: 22, size: '1rem', opacity: 0.6, priority: 1 },
  // priority 2: at 1.75rem starting at 66% it runs off the right edge on a phone
  { kind: 'text', content: 'read the disassembly', x: 66, y: 70, size: '1.75rem', weight: 500, opacity: 0.5, priority: 2 },
  { kind: 'text', content: 'it broke for a reason', x: 10, y: 78, size: '0.9375rem', opacity: 0.45, priority: 1 },
  { kind: 'text', content: 'everything is bytes', x: 6, y: 62, size: '0.875rem', font: 'mono', opacity: 0.45, priority: 2 },
  { kind: 'text', content: 'it crashed for a reason', x: 46, y: 14, size: '1rem', opacity: 0.4, rotate: -1, priority: 2 },
  { kind: 'text', content: 'ship the writeup', x: 78, y: 28, size: '0.8125rem', font: 'mono', opacity: 0.5, priority: 3 },
  { kind: 'text', content: 'trust nothing, verify', x: 24, y: 88, size: '0.875rem', opacity: 0.35, priority: 3 },
];

const ITEMS: Item[] = [...IMAGES, ...TEXT];

const COORDS = [
  { label: '(12, 45)', x: 2, y: 26 },
  { label: '(87, 23)', x: 93, y: 63 },
  { label: '(34, 78)', x: 25, y: 74 },
  { label: '(65, 91)', x: 67, y: 86 },
];

const BARS = [
  { x: 82, y: 8, w: 3, h: 42 },
  { x: 21, y: 86, w: 2, h: 30 },
  { x: 55, y: 3, w: 42, h: 3 },
];

const RULES = [
  { x: 4, y: 70, w: 18, rotate: -8 },
  { x: 54, y: 92, w: 14, rotate: 5 },
];

const BOXES = [
  { x: 9, y: 20, w: 70, h: 70, rotate: 12 },
  { x: 88, y: 40, w: 44, h: 44, rotate: -6 },
];

const GHOSTS = [
  { word: 'kappa', x: 31, y: 10, size: '7rem', rotate: -4 },
  { word: 'poggers', x: 84, y: 44, size: '4.5rem', rotate: 90 },
];

/* Build stamp, generated at build time rather than hand-edited. */
const d = new Date();
const build = `build ${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<div class="chaos" aria-hidden="true">
  <div class="chaos__grid"></div>

  {
    ITEMS.map((item) =>
      item.kind === 'image' ? (
        <div
          class="chaos__item chaos__img"
          data-priority={item.priority ?? 1}
          style={`left:${item.x}%;top:${item.y}%;width:min(${item.width}px, 42vw);opacity:${item.opacity ?? 0.5};transform:rotate(${item.rotate ?? 0}deg)`}
        >
          <Image src={item.src} alt="" loading="lazy" decoding="async" widths={[item.width, item.width * 2]} />
        </div>
      ) : (
        <span
          class="chaos__item chaos__text"
          data-priority={item.priority ?? 1}
          data-font={item.font ?? 'sans'}
          style={`left:${item.x}%;top:${item.y}%;font-size:${item.size ?? '1rem'};font-weight:${item.weight ?? 400};opacity:${item.opacity ?? 0.5};transform:rotate(${item.rotate ?? 0}deg)`}
        >
          {item.content}
        </span>
      )
    )
  }

  {GHOSTS.map((g) => (
    <span class="chaos__ghost" style={`left:${g.x}%;top:${g.y}%;font-size:${g.size};transform:rotate(${g.rotate}deg)`}>{g.word}</span>
  ))}

  {COORDS.map((c) => (
    <span class="chaos__coord" style={`left:${c.x}%;top:${c.y}%`}>{c.label}</span>
  ))}

  {BARS.map((b) => (
    <span class="chaos__bar" style={`left:${b.x}%;top:${b.y}%;width:${b.w}px;height:${b.h}px`}></span>
  ))}

  {RULES.map((r) => (
    <span class="chaos__rule" style={`left:${r.x}%;top:${r.y}%;width:${r.w}%;transform:rotate(${r.rotate}deg)`}></span>
  ))}

  {BOXES.map((b) => (
    <span class="chaos__box" style={`left:${b.x}%;top:${b.y}%;width:${b.w}px;height:${b.h}px;transform:rotate(${b.rotate}deg)`}></span>
  ))}

  <span class="chaos__bracket" data-corner="tl">┌</span>
  <span class="chaos__bracket" data-corner="tr">┐</span>
  <span class="chaos__bracket" data-corner="bl">└</span>
  <span class="chaos__bracket" data-corner="br">┘</span>

  <span class="chaos__status"><i class="chaos__dot"></i>{site.status}</span>
  <span class="chaos__build">{build}</span>
  <span class="chaos__scan"></span>
</div>

{/* Kept outside .chaos: focusable links must never live in an aria-hidden subtree,
    or keyboard users can tab to something screen readers refuse to announce. */}
<nav class="chaos__social" aria-label="Elsewhere">
  {socials.map((s) => (
    <a
      href={s.href}
      rel={s.href.startsWith('http') ? 'noopener me' : undefined}
      target={s.href.startsWith('http') ? '_blank' : undefined}>{s.label}</a>
  ))}
</nav>
