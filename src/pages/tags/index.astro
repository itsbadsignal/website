---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagChip from '../../components/TagChip.astro';
import { getTags } from '../../lib/posts';

const tags = await getTags();
---

<BaseLayout title="tags" description="Browse posts by tag.">
  <header class="page-head">
    <h1>tags</h1>
    <p>{tags.length} {tags.length === 1 ? 'tag' : 'tags'}, most used first.</p>
  </header>

  {
    tags.length > 0 ? (
      <ul class="tag-list">
        {tags.map(({ tag, count }) => (
          <li>
            <TagChip tag={tag} count={count} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="dim">no tags yet.</p>
    )
  }
</BaseLayout>

<style>
  .tag-list {
    list-style: none;
  }
</style>
