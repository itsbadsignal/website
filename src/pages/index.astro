---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostLog from '../components/PostLog.astro';
import { getPosts } from '../lib/posts';
import { site, now } from '../lib/site';

const all = await getPosts();
const posts = all.slice(0, 10);
---

<BaseLayout>
  <section class="intro">
    <p class="intro__lede">{site.lede}</p>
    <dl class="intro__now">
      {
        now.map((n) => (
          <div>
            <dt class="dim">{n.label}</dt>
            <dd>{n.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {posts.length > 0 ? <PostLog posts={posts} /> : <p class="dim">nothing published yet.</p>}

  {all.length > posts.length && <a class="back" href="/blog">full archive ({all.length}) →</a>}
</BaseLayout>

<style>
  .intro {
    margin-bottom: 1rem;
  }

  /* a terminal cursor waiting after the last word */
  .intro__lede::after {
    content: '';
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 0.3ch;
    vertical-align: text-bottom;
    background: var(--fg);
    animation: blink 1.1s steps(1) infinite;
  }

  .intro__now {
    margin-top: 1.25rem;
  }

  .intro__now div {
    display: grid;
    grid-template-columns: 10ch 1fr;
  }
</style>
