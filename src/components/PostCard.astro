---
import FormattedDate from './FormattedDate.astro';
import TagChip from './TagChip.astro';
import type { Post } from '../lib/posts';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { title, description, pubDate, tags, draft } = post.data;
---

<article class="card">
  <div class="card__meta">
    <FormattedDate date={pubDate} class="mono" />
    {draft && <span class="card__draft">draft</span>}
  </div>

  <h2 class="card__title">
    <a href={`/blog/${post.id}`}>{title}</a>
  </h2>

  <p class="card__desc">{description}</p>

  {
    tags.length > 0 && (
      <div class="card__tags">
        {tags.map((t) => (
          <TagChip tag={t} />
        ))}
      </div>
    )
  }
</article>

<style>
  .card {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--line);
  }

  .card__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .card__draft {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--bg);
    background: var(--accent);
    border-radius: 3px;
    padding: 0.05rem 0.35rem;
  }

  .card__title {
    font-size: clamp(1.15rem, 2.6vw, 1.5rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .card__title a {
    text-decoration: none;
  }

  .card__title a:hover {
    color: var(--accent);
  }

  .card__desc {
    color: var(--dim);
    max-width: var(--measure);
    text-wrap: pretty;
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.35rem;
  }
</style>
