---
/**
 * The three panels across the top of the landing page.
 *
 * Deliberately NOT part of the chaos layer. That layer is aria-hidden, which is
 * correct for decoration but would silently hide this from screen readers — it
 * is real content. Like .chaos__social it lives outside and fades with the same
 * --chaos-opacity, inherited here from .hero.
 */
import { panels } from '../lib/site';
---

<div class="panels">
  {
    panels.map((panel) => (
      <section class="panel">
        <h2 class="panel__title">{panel.title}</h2>
        <ul class="panel__list">
          {panel.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .panels {
    position: absolute;
    top: 6rem;
    left: 3rem;
    /* stop well clear of the portrait, which starts at 68% */
    right: 36%;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    text-align: left;
  }

  .panel__title {
    margin: 0 0 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: lowercase;
    color: var(--faint);
  }

  .panel__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.25rem;
  }

  .panel__list li {
    font-size: 0.875rem;
    line-height: 1.5;
    text-transform: lowercase;
    color: var(--dim);
    text-wrap: pretty;
  }

  /*
   * Below this the three columns are too narrow to hold a title without ragged
   * wrapping, so they stack and join the hero's grid flow, sitting above the
   * name rather than floating over it.
   */
  @media (max-width: 900px) {
    .panels {
      position: static;
      /* the hero centres its grid items, so without this the stacked panels
         shrink to fit and sit off-centre against the left-aligned text */
      justify-self: stretch;
      width: 100%;
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding-inline: var(--gutter);
      margin-bottom: 2rem;
    }

    .panel__list li {
      font-size: 0.8125rem;
    }
  }
</style>
