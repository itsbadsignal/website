---
import { Image } from 'astro:assets';
import { coverPattern, type Post } from '../lib/posts';

interface Props {
  post: Post;
  /** The post banner loads eagerly; list covers are lazy. */
  eager?: boolean;
}

const { post, eager = false } = Astro.props;
const { cover, coverAlt } = post.data;
---

{
  cover ? (
    /* Covers are 1-bit dithered PNGs from `npm run cover`. Any resampling
       (srcset widths, webp) would blur the dots into grey, so they are served
       at their own size as PNG and scaled by the browser with pixelated
       rendering. */
    <Image
      class="cover cover--pixel"
      src={cover}
      alt={coverAlt}
      width={cover.width}
      height={cover.height}
      format="png"
      loading={eager ? 'eager' : 'lazy'}
    />
  ) : (
    <div class="cover cover--pattern" style={coverPattern(post.id)} aria-hidden="true" />
  )
}

