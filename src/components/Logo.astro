---
/*
 * The mark: a pixel skull drawn as scanlines, two rows slipped sideways and a
 * few stray pixels leaking off the edges, like a defacement on a dying CRT.
 * Each rect is one run of pixels in one row of a 9x9 skull (6px pitch, 4px
 * bars). public/favicon.svg is the same drawing with a fixed fill.
 */
---

<svg
  viewBox="0 0 64 64"
  width="96"
  height="96"
  shape-rendering="crispEdges"
  role="img"
  aria-label="miguelc">
  <g fill="currentColor">
    <rect x="17" y="5" width="30" height="4"></rect>
    <rect x="11" y="11" width="42" height="4"></rect>
    <rect x="5" y="17" width="54" height="4"></rect>
    <rect x="10" y="23" width="12" height="4"></rect>
    <rect x="34" y="23" width="6" height="4"></rect>
    <rect x="52" y="23" width="12" height="4"></rect>
    <rect x="5" y="29" width="12" height="4"></rect>
    <rect x="29" y="29" width="6" height="4"></rect>
    <rect x="47" y="29" width="12" height="4"></rect>
    <rect x="5" y="35" width="54" height="4"></rect>
    <rect x="5" y="41" width="18" height="4"></rect>
    <rect x="29" y="41" width="18" height="4"></rect>
    <rect x="17" y="47" width="30" height="4"></rect>
    <rect x="17" y="53" width="6" height="4"></rect>
    <rect x="29" y="53" width="6" height="4"></rect>
    <rect x="41" y="53" width="6" height="4"></rect>
    <rect x="59" y="29" width="3" height="4"></rect>
    <rect x="0" y="41" width="3" height="4"></rect>
    <rect x="57" y="11" width="5" height="4"></rect>
  </g>
</svg>
