---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { site, nav, socials } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** KaTeX CSS is ~23KB + fonts — only load it on pages with math. */
  math?: boolean;
  /** Absolute or root-relative OG image URL. LinkedIn won't render a preview without one. */
  image?: string;
  /** The 404 page opts out of the prank: a lost visitor has suffered enough. */
  prank?: boolean;
}

const {
  title,
  description = site.description,
  math = false,
  image = site.ogImage,
  prank = true,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const path = Astro.url.pathname;
const year = new Date().getFullYear();

const links = [...nav, ...socials];
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : href.startsWith('/') && path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href="/fonts/jetbrains-mono-400.woff2" as="font" type="font/woff2" crossorigin />

    {math && <link rel="stylesheet" href="/katex/katex.min.css" />}
  </head>

  <body>
    <a href="#content" class="sr-only">Skip to content</a>

    <header class="site-head wrap">
      <a class="site-head__logo" href="/" aria-label="index">
        <Logo />
      </a>
      <nav aria-label="Primary">
        <ul>
          {
            links.map((l) => (
              <li>
                <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <div class="wrap"><hr /></div>

    <main id="content" class="wrap">
      <slot />
    </main>

    <footer class="site-foot wrap">
      <hr />
      <p>&copy; {year} {site.name}</p>
    </footer>

    {
      prank && (
        <>
          <div id="pwned" role="dialog" aria-modal="true" aria-label="Site defaced" hidden />
          {/* is:inline keeps Astro from bundling it: this is the only JS on the site. */}
          <script is:inline src="/prank.js" defer />
        </>
      )
    }
  </body>
</html>
