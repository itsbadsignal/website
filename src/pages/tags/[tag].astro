---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostLog from '../../components/PostLog.astro';
import { getTags, getPostsByTag } from '../../lib/posts';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const tags = await getTags();
  return Promise.all(
    tags.map(async ({ tag }) => ({
      params: { tag },
      props: { tag, posts: await getPostsByTag(tag) },
    }))
  );
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`Posts tagged ${tag}.`}>
  <header class="page-head">
    <h1>#{tag}</h1>
    <p>{posts.length} {posts.length === 1 ? 'entry' : 'entries'} tagged {tag}.</p>
  </header>

  <PostLog posts={posts} />

  <a class="back" href="/tags">← all tags</a>
</BaseLayout>
